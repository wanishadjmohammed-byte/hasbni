# ─────────────────────────────────────────────────────────────────────────────
# Copier en `.env.local`.
#
# Supabase — Project Settings > API
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Mode demonstration : jeu de donnees local, aucune requete reseau.
#
# A poser explicitement. Un build de production sans variables Supabase ET sans
# ce drapeau echoue volontairement : une app deployee avec des potes fictifs
# ressemble a une app qui marche, et personne ne s'en apercoit.
# ─────────────────────────────────────────────────────────────────────────────

# NEXT_PUBLIC_DEMO=1

# ─────────────────────────────────────────────────────────────────────────────
# Optionnel — collecteur d'erreurs (Sentry, GlitchTip, route maison).
# Les rapports y sont postes en sendBeacon depuis `src/lib/report.ts`.
# ─────────────────────────────────────────────────────────────────────────────

# NEXT_PUBLIC_ERROR_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────────
# CONSOLE D'ADMINISTRATION (/admin)
#
# Ces variables ne sont PAS prefixees NEXT_PUBLIC_ : elles ne doivent jamais
# atteindre le navigateur. `SUPABASE_SERVICE_ROLE_KEY` contourne entierement la
# RLS — dans un bundle client, elle donnerait la base complete a quiconque ouvre
# les outils de developpement.
#
# Sans elles, /admin renvoie une erreur explicite ; le reste de l'app tourne.
# ─────────────────────────────────────────────────────────────────────────────

# Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Cle de signature du cookie de session admin. 32 caracteres minimum.
# Generer : openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Secret partage pour declencher l'agregation journaliere par un cron :
#   curl -X POST https://…/api/admin/rollup -H "x-rollup-secret: …"
ADMIN_ROLLUP_SECRET=
